# ─── OKX OnchainOS API Credentials ────────────────────────────────────────────
# Get these from: https://web3.okx.com/onchainos/dev-portal
# NEVER commit this file to git — copy to .env and fill in your values
OKX_API_KEY=your-api-key
OKX_SECRET_KEY=your-secret-key
OKX_PASSPHRASE=your-passphrase

# ─── Agentic Wallet ──────────────────────────────────────────────────────────
# Your agent's on-chain identity address
AGENTIC_WALLET_ADDRESS=0x...

# ─── Server Config ───────────────────────────────────────────────────────────
PORT=3402
XLAYER_RPC_URL=https://rpc.xlayer.tech

# ─── X402 Payment Config ─────────────────────────────────────────────────────
X402_DEMO_MODE=true
SCAN_PRICE_USD=0.005
